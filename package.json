{
  "name": "snippet-manager",
  "version": "1.0.0",
  "description": "Gerenciador de snippets de código com SQLite embarcado",
  "author": "Mário Oliveira <maper765@gmail.com>",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/maper765/snippet-manager.git"
  },
  "scripts": {
    "postinstall": "electron-rebuild -w better-sqlite3 -f",
    "start": "electron-forge start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf out",
    "package": "npm run clean && electron-forge package",
    "make": "npm run clean && electron-forge make",
    "publish": "npm run clean && electron-forge publish"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "electron": "^32.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.2.0"
  }
}
